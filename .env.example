# ==========================================================================
# ÖNEMLİ: Uygulama API anahtarlarını öncelikle FIREBASE REMOTE CONFIG'ten okur.
# Bu dosya artık pakete GÖMÜLMEZ ve git'e girmez; sadece parametre adlarını
# ve yerel geliştirme için örnek değerleri gösterir.
#
# Yayında anahtarları şuraya girin:
#   Firebase Console -> Remote Config -> Parametre ekle
#   (aşağıdaki BÜYÜK_HARF adları birebir kullanın) -> Değişiklikleri yayınla
# Böylece repoyu klonlayan herkeste uygulama çalışır ve anahtarı değiştirmek
# için yeniden yayın gerekmez.
# ==========================================================================

# Google Gemini (masal üretimi, çizimden masal, moderasyon)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# AI illüstrasyon (premium video sahneleri) — karakter tutarlılığı için
# referans-görsel destekleyen Gemini görsel modeli ("Nano Banana")
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Seslendirme sağlayıcısı: elevenlabs | voxcpm
TTS_PROVIDER=elevenlabs

# ElevenLabs (stüdyo kalitesinde sesli masal anlatımı)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# VoxCPM backend (kendi GPU sunucun) — TTS_PROVIDER=voxcpm olunca kullanılır
VOXCPM_BASE_URL=https://senin-backend-adresin.com
VOXCPM_API_KEY=backend_ile_ayni_gizli_anahtar
